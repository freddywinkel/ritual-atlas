{
  "name": "ritual-atlas",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "vinext start",
    "test": "npm run build:pages && npm run test:unit",
    "test:unit": "node --test tests/rendered-html.test.mjs tests/storage.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "art:optimize": "node scripts/optimize-card-art.mjs",
    "art:audit": "node --experimental-strip-types scripts/audit-card-art.mjs",
    "art:index": "node --experimental-strip-types scripts/build-card-art-index.mjs",
    "art:contact": "node --experimental-strip-types scripts/build-card-contact-sheets.mjs",
    "art:social": "node scripts/optimize-social-art.mjs",
    "verify:offline": "node scripts/verify-offline.mjs --pages",
    "verify:pages": "npm run build:pages && npm run verify:offline"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.2.1"
  },
  "type": "module"
}
